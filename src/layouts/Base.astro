---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/700.css';
import '@fontsource/big-shoulders-stencil/900.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sito from '../data/sito.json';
import { url } from '../lib/url';
import { T, percorso, testiSito, type Lang } from '../lib/i18n';
import { getEntry } from 'astro:content';
import Bandiera from '../components/Bandiera.astro';

interface Props {
  lang: Lang;
  titolo?: string;
  descrizione?: string;
  immagineSocial?: ImageMetadata;
  attiva?: 'home' | 'opere' | 'artista' | 'allestimenti' | 'contatti';
  /** stessa pagina nell'altra lingua */
  alternativa: string;
}
const { lang, titolo, immagineSocial, attiva, alternativa } = Astro.props;
const t = T[lang];
const testi = testiSito(lang);
const descrizione = Astro.props.descrizione ?? testi.descrizione;
const altra: Lang = lang === 'it' ? 'en' : 'it';

const titoloPagina = titolo ? `${titolo} | ${sito.nome}` : `${sito.nome}, ${sito.titoloSerie}`;

// Immagine di anteprima per WhatsApp, Instagram, Facebook
const apertura = await getEntry('opere', sito.operaInApertura);
const sorgenteSocial = immagineSocial ?? apertura?.data.immagine;
const social = sorgenteSocial ? await getImage({ src: sorgenteSocial, width: 1200, format: 'jpg', quality: 80 }) : null;
const socialAssoluta = social ? new URL(social.src, Astro.site).href : null;
const assoluto = (p: string) => new URL(p, Astro.site).href;

const voci = (['home', 'opere', 'artista', 'allestimenti', 'contatti'] as const).map((k) => ({
  chiave: k, etichetta: t.menu[k], href: percorso(lang, k),
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    {!sito.indicizzabile && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <link rel="alternate" hreflang={lang} href={assoluto(Astro.url.pathname)} />
    <link rel="alternate" hreflang={altra} href={assoluto(alternativa)} />
    <meta property="og:site_name" content={sito.nome} />
    <meta property="og:title" content={titoloPagina} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    {socialAssoluta && <meta property="og:image" content={socialAssoluta} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Introduzione solo alla prima visita della sessione, mai per chi ha ridotto le animazioni
      try {
        if (!sessionStorage.getItem('siro-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('intro');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="intro-schermo" aria-hidden="true"></div>
    <div class="intro-parola" aria-hidden="true"><span class="intro-marchio"><span class="intro-sagoma">SIRO</span><span class="intro-colore">SIRO</span></span></div>
    <div class="pagina">
      <header class="testata">
        <a class="firma" href={percorso(lang, 'home')} aria-label={`${sito.nome}, ${t.paginaIniziale}`}>{sito.nome.toUpperCase()}</a>
      </header>
      <nav class="menu" aria-label={t.menuPrincipale}>
        <ul>
          {voci.map((v) => (
            <li>
              <a
                href={v.href}
                class={attiva === v.chiave ? 'nastro' : undefined}
                aria-current={attiva === v.chiave ? 'page' : undefined}
              >{v.etichetta}</a>
            </li>
          ))}
          <li class="lingua"><a class="bandiera" href={alternativa} hreflang={altra} lang={altra} aria-label={t.altraLingua} title={t.altraLingua}><Bandiera lingua={altra} /></a></li>
        </ul>
      </nav>
      <main id="contenuto">
        <slot />
      </main>
      <footer class="piede">
        <p>© {new Date().getFullYear()} {sito.nome}.</p>
      </footer>
    </div>
    <script>
      // SIRO come cursore: scende di pari passo con lo scorrimento della pagina.
      const testata = document.querySelector<HTMLElement>('.testata');
      const firma = document.querySelector<HTMLElement>('.testata .firma');
      const desktop = matchMedia('(min-width: 1000px)');
      let inAttesa = false;
      function aggiorna() {
        inAttesa = false;
        if (!testata || !firma) return;
        if (!desktop.matches) { firma.style.removeProperty('--y'); return; }
        const max = document.documentElement.scrollHeight - innerHeight;
        const avanzamento = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
        const st = getComputedStyle(testata);
        const corsa = testata.clientHeight - parseFloat(st.paddingTop) - parseFloat(st.paddingBottom) - firma.offsetHeight;
        firma.style.setProperty('--y', `${(avanzamento * Math.max(0, corsa)).toFixed(1)}px`);
      }
      const chiedi = () => { if (!inAttesa) { inAttesa = true; requestAnimationFrame(aggiorna); } };
      addEventListener('scroll', chiedi, { passive: true });
      addEventListener('resize', chiedi);
      desktop.addEventListener('change', chiedi);
      addEventListener('load', aggiorna);
      aggiorna();

      // Introduzione "stencil": la sagoma, la pennellata, poi SIRO vola al suo posto
      const radice = document.documentElement;
      if (radice.classList.contains('intro')) {
        const schermo = document.querySelector<HTMLElement>('.intro-schermo')!;
        const marchio = document.querySelector<HTMLElement>('.intro-marchio')!;
        let finita = false;
        const fine = () => {
          if (finita) return;
          finita = true;
          radice.classList.remove('intro');
          try { sessionStorage.setItem('siro-intro', '1'); } catch {}
          schermo.remove();
          document.querySelector('.intro-parola')?.remove();
        };
        const vola = async () => {
          if (finita || !firma) return fine();
          await document.fonts.ready;
          const a = marchio.getBoundingClientRect();
          const b = firma.getBoundingClientRect();
          const sf = getComputedStyle(firma);
          const verticale = sf.writingMode.startsWith('vertical');
          const scala = parseFloat(sf.fontSize) / parseFloat(getComputedStyle(marchio).fontSize);
          const dx = b.left + b.width / 2 - (a.left + a.width / 2);
          const dy = b.top + b.height / 2 - (a.top + a.height / 2);
          const curva = 'cubic-bezier(0.7, 0, 0.2, 1)';
          marchio.animate(
            [{ transform: 'none' }, { transform: `translate(${dx}px, ${dy}px) rotate(${verticale ? -90 : 0}deg) scale(${scala})` }],
            { duration: 720, easing: curva, fill: 'forwards' },
          );
          schermo.animate([{ transform: 'translateY(0)' }, { transform: 'translateY(-100%)' }], { duration: 720, easing: curva, fill: 'forwards' })
            .finished.then(fine, fine);
        };
        setTimeout(vola, 1150);
        addEventListener('pointerdown', fine, { once: true });
        addEventListener('keydown', fine, { once: true });
        setTimeout(fine, 3200); // in ogni caso il sito si apre
      }
    </script>
  </body>
</html>
